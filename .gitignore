# Installed or packaged binaries are published as GitHub Release assets.
**/*.apk
**/*.aab
**/*.ipa
**/*.xcarchive/
**/*.xcframework/
**/*.dSYM/

# Main contains only the current SDK deliveries; download native binaries from Releases.
/dist/*
!/dist/README.md
!/dist/SHA256SUMS
!/dist/versions.json
!/dist/IMSDK-iOS-0.1.3.zip.sha256
!/dist/IMSDK-Android-0.1.3.zip.sha256
!/dist/IMSDK-Web-H5-0.1.6.zip.sha256
!/dist/ios-native-0.1.3/
!/dist/android-native-0.1.3/
!/dist/web-h5-0.1.6/
/dist/ios-native-0.1.3/binary/
/dist/android-native-0.1.3/maven/

# Native dependency locks are part of the reproducible source checkout.
!**/Podfile.lock
