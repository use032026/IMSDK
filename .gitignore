.DS_Store
**/.dart_tool/
**/.l10n-cache/
**/.flutter-plugins*
**/.gradle/
**/build/
**/.idea/
**/*.iml
module/.android/
module/.ios/
**/Pods/
**/.symlinks/
**/local.properties
**/Generated.xcconfig
**/flutter_export_environment.sh
**/key.properties
**/*.jks
**/*.keystore
**/*.p12
**/*.mobileprovision
**/.env
**/.env.*
logs/
.work/runtime-private/
web/node_modules/
web/dist/
# Local task state, private inputs and build evidence.
/.work/
/.codex-build/
**/__pycache__/
**/*.pyc
**/xcuserdata/
**/*.xcuserstate
**/validation-products/
**/.cxx/
**/pubspec_overrides.yaml
