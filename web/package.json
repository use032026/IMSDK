{
  "name": "@imsdk/web",
  "version": "0.1.1",
  "description": "Embeddable IM SDK for H5 with personal and tenant messaging",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": { ".": { "types": "./dist/types/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist", "README.md", "example"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "prepack": "npm run typecheck && npm run build"
  },
  "dependencies": { "@microsoft/signalr": "8.0.17" },
  "devDependencies": { "esbuild": "0.25.12", "typescript": "5.9.3", "@playwright/test": "1.60.0" },
  "engines": { "node": ">=20" },
  "license": "UNLICENSED"
}
